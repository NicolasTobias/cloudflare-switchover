# Required
CLOUDFLARE_API_TOKEN=your_cf_api_token

# DOMAIN_RECORDS contiene JSON — Docker Compose no soporta comillas en .env files.
# Exportar como variable de shell antes de levantar:
#   export DOMAIN_RECORDS='[{"zone_id":"abc123","record_name":"tardigram.com","fallback_type":"A","fallback_content":"5.161.x.x"}]'
#   docker compose up

# Optional - notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_ID=
SLACK_WEBHOOK_URL=

# Optional - defaults shown
POLL_INTERVAL=300000
HAYAHORA_URL=https://hayahora.futbol/estado/data.json
HEALTH_CHECK_PORT=8080
FOOTBALL_THRESHOLD=0.5
