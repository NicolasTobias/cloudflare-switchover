# Plantilla. El secret real NO va en git: se gestiona en el cluster (namespace
# monitoring), orfanado de ArgoCD. Para (re)crearlo manualmente:
#   kubectl create secret generic cloudflare-switchover-secret -n monitoring \
#     --from-literal=CLOUDFLARE_API_TOKEN=... \
#     --from-literal=TELEGRAM_BOT_TOKEN=... \
#     --from-literal=TELEGRAM_CHAT_ID=... \
#     --from-literal=TELEGRAM_THREAD_ID=... \
#     --from-literal=SLACK_WEBHOOK_URL=...
# y des-trackearlo de ArgoCD:
#   kubectl annotate secret cloudflare-switchover-secret -n monitoring \
#     argocd.argoproj.io/tracking-id- argocd.argoproj.io/sync-options=Prune=false
apiVersion: v1
kind: Secret
metadata:
  name: cloudflare-switchover-secret
type: Opaque
stringData:
  CLOUDFLARE_API_TOKEN: "REPLACE"
  TELEGRAM_BOT_TOKEN: "REPLACE"
  TELEGRAM_CHAT_ID: "REPLACE"
  TELEGRAM_THREAD_ID: "REPLACE"
  SLACK_WEBHOOK_URL: "REPLACE"
